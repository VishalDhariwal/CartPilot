# ─── Database Configuration (PostgreSQL Native) ────────────────────────────
# When running locally on host machine:
DATABASE_URL=postgresql://localhost:5432/cartpilot

# When running inside Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/cartpilot

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
BYPASS_RAZORPAY=true

# ─── AI & LLM Providers (Dual-Provider Architecture) ─────────────────────
# Google Gemini (Primary / Secondary)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI (Optional Fallback / Primary)
# OPENAI_API_KEY=sk-your_openai_key

# Optional provider preference: "gemini" or "openai" (auto-detected if unset)
# LLM_PROVIDER=gemini

# ─── Merchant Security ───────────────────────────────────────────────────
CARTPILOT_MERCHANT_KEY=cartpilot_merchant_secret_key_v1

# ─── Weather & Environmental Signals ───────────────────────────────────────
# OpenWeatherMap API Key (Free Tier supported)
OPENWEATHER_API_KEY=your_openweathermap_api_key
DEFAULT_WEATHER_CITY=Delhi
